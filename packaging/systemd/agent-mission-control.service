# Installed by the agent-mission-control package. Per user, enable it with
# `amc install --enable` (also sets up the agent integrations), or just
# `systemctl --user enable --now agent-mission-control`.
[Unit]
Description=agent-mission-control: agent workflow state daemon
Documentation=https://github.com/rgolangh/agent-mission-control

[Service]
ExecStart=/usr/bin/amc serve -discover
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
