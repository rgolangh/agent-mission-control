post_install() {
  cat <<'EOF2'
==> agent-mission-control: set it up once per user (not as root):
      amc install --enable
    This enables the packaged user service (agent-mission-control.service)
    and links the OpenCode, Claude Code and Omarchy integrations it finds
    into your home (from /usr/share/agent-mission-control, so upgrades
    update them). Check it with: amc doctor
==> Before removing the package, run `amc uninstall` as each user.
EOF2
}

post_upgrade() {
  cat <<'EOF2'
==> agent-mission-control: per user, restart the daemon (and the Omarchy bar):
      systemctl --user restart agent-mission-control && omarchy-restart-shell
    Set up with a version before 0.1.3? Run `amc install` once: it replaces
    the copies in your home with links to the package's files.
EOF2
}
